<mvc:View controllerName="srbUI5QualityChecks.controller.startpage" xmlns:html="http://www.w3.org/1999/xhtml" xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:form="sap.ui.layout.form" xmlns:tnt="sap.tnt" xmlns:fb="sap.ui.comp.filterbar" xmlns:f="sap.f" xmlns:card="sap.f.cards" 
	xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<Page id="startpage" showHeader="false">
		<OverflowToolbar>
			<Title text="SRB UI5 Apps Quality Checks" level="H2" />
			<ObjectStatus class="lowerTitleText" text="{/stillFetching/indicationText}" state="Error" visible="{=${/stillFetching/fetchedPercentage} &lt; 50}" />
			<ObjectStatus class="lowerTitleText" text="{/stillFetching/indicationText}" state="Warning" visible="{=${/stillFetching/fetchedPercentage} &gt; 49 &amp;&amp; ${/stillFetching/fetchedPercentage} !== 100}" />
			<ObjectStatus class="lowerTitleText" text="{/stillFetching/indicationText}" state="Success" visible="{=${/stillFetching/fetchedPercentage} === 100}" />
			<ToolbarSpacer />
			<ToolbarSpacer />
			<Label id="usernameLabel" />
			<Avatar
				id="myAvatar"
				src="{/Woman01}"
				displaySize="XS"
				showBorder="true"
				class="sapUiTinyMargin"
				press="onPress"/>
			<Button icon="sap-icon://dark-mode" press="changeTheme"/>
		</OverflowToolbar>
		<Panel expandable="true" visible="false" id="filterPanel" class="sapUiSmallMarginTopBottom">
			<headerToolbar>
				<OverflowToolbar>
					<Title text="Filter Repository List"/>
				</OverflowToolbar>
			</headerToolbar>
			<SearchField id="searchField" liveChange=".onSearch" placeholder="Search for Repository" width="100%"  />
			<fb:FilterBar showGoButton="false" id="filterbar" persistencyKey="myPersKey" useToolbar="false" search="onSelectionChange" filterChange=".onFilterChange" afterVariantLoad=".onAfterVariantLoad">
				<fb:filterGroupItems>
					<fb:FilterGroupItem name="version" label="Specific Version" groupName="Group1" visibleInFilterBar="true">
						<fb:control>
								<ComboBox
									id="version"
									name="version"
									change="onSelectionChange"
								>
									<core:Item key="0" text="Found"/>
									<core:Item key="1" text="Not found"/>
								</ComboBox>
							</fb:control>
						</fb:FilterGroupItem>
					<fb:FilterGroupItem name="bootstrap" label="Evergreen Bootstrap" groupName="Group1" visibleInFilterBar="true">
						<fb:control>
							<ComboBox
								id="bootstrap"
								name="bootstrap"
								change="onSelectionChange"
							>
								<core:Item key="0" text="Found"/>
								<core:Item key="1" text="Not found"/>
							</ComboBox>
						</fb:control>
					</fb:FilterGroupItem>
					<fb:FilterGroupItem name="lintJobs" label="Workflow Jobs" groupName="Group1" visibleInFilterBar="true">
						<fb:control>
							<ComboBox
								id="lintJobs"
								name="lintJobs"
								change="onSelectionChange"
							>
								<core:Item key="0" text="Passed"/>
								<core:Item key="1" text="Not Passed"/>
								<core:Item key="2" text="Not found"/>
							</ComboBox>
						</fb:control>
					</fb:FilterGroupItem>
					<fb:FilterGroupItem name="issuesItem" label="Open Issues" groupName="Group1" visibleInFilterBar="true">
						<fb:control>
							<ComboBox
								id="issues"
								name="issues"
								change="onSelectionChange"
							>
								<core:Item key="0" text="Found"/>
								<core:Item key="1" text="Not found"/>
							</ComboBox>
						</fb:control>
					</fb:FilterGroupItem>
					<fb:FilterGroupItem name="myIssue" label="Show Repos" groupName="Group1" visibleInFilterBar="true">
						<fb:control>
							<ComboBox
								id="myIssue"
								name="myIssue"
								change="onSelectionChange"
							>
								<core:Item key="0" text="All"/>
								<core:Item key="1" text="I have Issues"/>
							</ComboBox>
						</fb:control>
					</fb:FilterGroupItem>
					<fb:FilterGroupItem name="company" label="Specific Company" groupName="Group1" visibleInFilterBar="true">
						<fb:control>
							<Input
								id="companyInput"
								placeholder="Enter Company"
								showSuggestion="true"
								showValueHelp="true"
								valueHelpRequest=".onValueHelpRequest"
								suggestionItems="{/repoNames}">
								<suggestionItems>
									<core:Item text="{Name}" />
								</suggestionItems>
							</Input>
						</fb:control>
					</fb:FilterGroupItem>
				</fb:filterGroupItems>
			</fb:FilterBar>
			<VBox width="100%">
				<Label text="Percentage of quality" class="sapUiSmallMarginTop" />
				<RangeSlider id="qualitySlider" showAdvancedTooltip="true" min="0" max="100" width="100%" class="sapUiMediumMarginBottom" change="onSelectionChange" />
			</VBox>
		</Panel>
						
		<List id="list" width="auto" class="sapFDynamicPageAlignContent" visible="false"
				items="{ path: '/results', sorter: { path: 'repo', descending: false, group: '.getRepo'},groupHeaderFactory: '.getGroupHeader' }" growing="true" growingScrollToLoad="true" sticky="HeaderToolbar" itemPress="onItemDialogOpen">
				<core:Fragment fragmentName="srbUI5QualityChecks.view.fragments.listItem" type="XML" />
		</List>
		<FlexBox id="loginBox" alignItems="Center" fitContainer="false" justifyContent="Center" direction="Column">
			<f:Card class="sapUiMediumMarginTop sapUiMediumMarginBottom barcodeCard" width="100%" height="100%" >
				<f:header>
				</f:header>
				<f:content>
					<FlexBox id="barcodeInputFlexbox" height="100%" width="100%" alignItems="Center" fitContainer="true" justifyContent="Center" direction="Column"
						class="sapUiTinyMarginTop sapUiTinyMarginBottom">
						<Label text="GitHub Access Token:" />
						<Input
						id="tokenInput"
						type="Password"
						width="300px"
						value="" 
						placeholder="GitHub Access Token" />
						<Button type="Accept" press=".startPressed" text="Fetch GitHub repos" />
					</FlexBox>
				</f:content>
			</f:Card>
		</FlexBox>
	</Page>
</mvc:View>